{
 "name":"mochi-mayhem",
 "main":"cloudflare/worker.ts",
 "compatibility_date":"2026-05-15",
 "workers_dev":true,
 "assets":{"directory":"./dist/cloudflare","binding":"ASSETS","not_found_handling":"single-page-application","run_worker_first":["/api/*"]},
 "durable_objects":{"bindings":[{"name":"GAME_ROOMS","class_name":"GameRoom"}]},
 "migrations":[{"tag":"v1","new_sqlite_classes":["GameRoom"]}],
 "observability":{"enabled":false}
}
